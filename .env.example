# FastAPI / Azure SQL
SQL_CONNECTION_STRING=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MIN_HISTORY_RUNS=5

# Azure Function used by FastAPI for historical ingestion
# Azure: https://<function-app>.azurewebsites.net/api/ingest_pipeline?code=<FUNCTION_KEY>
# Local Core Tools: http://127.0.0.1:7071/api/ingest_pipeline?code=<LOCAL_FUNCTION_KEY>
INGEST_FUNCTION_URL=

# Azure OpenAI v1
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-14
AZURE_OPENAI_API_KEY=
# Optional: a stronger deployment used only by the AI pull request review (leave empty to use AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_REVIEW_DEPLOYMENT=

# Azure Function settings
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_PIPELINE_ID=
ADO_DAYS=90
ADO_PAT=
ADO_PAT_SECRET_NAME=ado-pat
# Optional multi-organization Key Vault convention, for example ado-pat-{organization}.
# Organization names are normalized to lowercase and hyphen-separated.
ADO_PAT_SECRET_TEMPLATE=
KEY_VAULT_URL=

# --- Sign-in (username/password) ---
# Deployed: credentials come from Key Vault secrets app-auth-username / app-auth-password (+ optional app-auth-session-secret).
# The password secret may be plain text or a pbkdf2_sha256$... verifier (python -c "from app.core.session_auth import hash_password as h; print(h('...'))").
# Local development: either turn sign-in off ...
# REQUIRE_LOGIN=false
# ... or leave KEY_VAULT_URL empty and set a local account:
# AUTH_USERNAME=dev
# AUTH_PASSWORD=change-me
