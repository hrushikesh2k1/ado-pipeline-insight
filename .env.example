# FastAPI / Azure SQL
SQL_CONNECTION_STRING=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MIN_HISTORY_RUNS=5

# Azure Function used by FastAPI for historical ingestion
# Azure: https://<function-app>.azurewebsites.net/api/ingest_pipeline?code=<FUNCTION_KEY>
# Local Core Tools: http://127.0.0.1:7071/api/ingest_pipeline?code=<LOCAL_FUNCTION_KEY>
INGEST_FUNCTION_URL=

# Azure OpenAI v1
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-14
AZURE_OPENAI_API_KEY=

# Azure Function settings
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_PIPELINE_ID=
ADO_DAYS=90
ADO_PAT=
ADO_PAT_SECRET_NAME=ado-pat
KEY_VAULT_URL=
