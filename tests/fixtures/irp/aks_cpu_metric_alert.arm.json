{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": { "type": "string", "defaultValue": "aks-orders-prod" },
    "actionGroupId": { "type": "string", "defaultValue": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-monitoring/providers/Microsoft.Insights/actionGroups/ag-oncall" }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "AKS - Container CPU Usage exceeded 80 percent",
      "location": "global",
      "properties": {
        "description": "Average CPU of the AKS nodes is above 80 percent.",
        "severity": 2,
        "enabled": true,
        "scopes": [ "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]" ],
        "evaluationFrequency": "PT1M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "Metric1",
              "metricName": "node_cpu_usage_percentage",
              "metricNamespace": "Insights.Container/nodes",
              "operator": "GreaterThan",
              "threshold": 80,
              "timeAggregation": "Average",
              "dimensions": [
                { "name": "host", "operator": "Include", "values": [ "*" ] }
              ]
            }
          ]
        },
        "autoMitigate": true,
        "actions": [ { "actionGroupId": "[parameters('actionGroupId')]" } ]
      }
    }
  ]
}
